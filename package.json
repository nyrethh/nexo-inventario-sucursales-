{
  "name": "nexo-inventario-vercel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server.mjs",
    "build": "node scripts/build.mjs",
    "db:setup": "node --env-file-if-exists=.env.local scripts/database.mjs",
    "admin": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.admin.local scripts/admin.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14"
  }
}
